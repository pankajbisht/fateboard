# Copy to .env (git-ignored) and fill in. Vite exposes VITE_* values to the app at build time.
# In CI these come from GitHub repository variables (Settings > Secrets and variables > Actions > Variables).

# Required for every build: the public site origin, no path (canonical links, Open Graph, sitemap, robots.txt).
VITE_SITE_URL=https://www.example.com

# Optional: Google Analytics measurement id (G-XXXXXXX). Empty = no analytics.
VITE_GA_ID=
