{
    "name": "fateboard",
    "homepage": "https://www.fateboard.com",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": "26.13.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:no-check": "vite build",
        "prebuild": "npm run type-check",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "preview": "vite preview --host 0.0.0.0",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 254",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "check": "npm run lint && npm run type-check && npm run format:check",
        "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p e2e/tsconfig.json",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "report": "npm run test:coverage && npm run e2e",
        "build:e2e": "vite build --mode e2e --outDir dist-e2e",
        "e2e": "playwright test",
        "e2e:report": "playwright show-report",
        "prepare": "husky"
    },
    "dependencies": {
        "@tailwindcss/vite": "4.3.4",
        "clsx": "2.1.1",
        "fabric": "7.4.0",
        "jspdf": "4.2.1",
        "lucide-react": "1.69.0",
        "mp4-muxer": "5.2.2",
        "nanoid": "6.0.2",
        "opendb-store": "2.0.1",
        "paper": "0.12.18",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router-dom": "7.18.5",
        "tailwindcss": "4.3.4",
        "zustand": "5.0.16"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.1",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.2.1",
        "@vitest/coverage-v8": "5.1.0",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.14.0",
        "husky": "9.1.7",
        "jsdom": "31.0.0",
        "lint-staged": "17.6.0",
        "prettier": "3.9.10",
        "pretty-quick": "4.2.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.6",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "5.1.0"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx,json,css,md}": [
            "prettier --write",
            "eslint --fix"
        ]
    }
}
