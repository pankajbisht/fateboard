{
    "name": "fateboard",
    "homepage": "https://www.fateboard.com",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": "26.13.0"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w @fateboard/web --",
        "build": "npm run build -w @fateboard/web --",
        "build:no-check": "npm run build:no-check -w @fateboard/web --",
        "clean": "npm run clean -w @fateboard/web --",
        "preview": "npm run preview -w @fateboard/web --",
        "lint": "npm run lint -w @fateboard/web --",
        "format": "npm run format -w @fateboard/web --",
        "format:check": "npm run format:check -w @fateboard/web --",
        "check": "npm run check -w @fateboard/web --",
        "type-check": "npm run type-check -w @fateboard/web --",
        "test": "npm run test -w @fateboard/web --",
        "test:watch": "npm run test:watch -w @fateboard/web --",
        "test:run": "npm run test:run -w @fateboard/web --",
        "test:coverage": "npm run test:coverage -w @fateboard/web --",
        "report": "npm run report -w @fateboard/web --",
        "build:e2e": "npm run build:e2e -w @fateboard/web --",
        "e2e": "npm run e2e -w @fateboard/web --",
        "e2e:report": "npm run e2e:report -w @fateboard/web --",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "9.1.7",
        "lint-staged": "17.6.0"
    },
    "lint-staged": {
        "apps/web/src/**/*.{js,jsx,ts,tsx,json,css,md}": [
            "prettier --write",
            "eslint --fix"
        ]
    }
}
