{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm run check)",
            "Bash(npm run lint)",
            "Bash(npm run type-check)",
            "Bash(npm run format)",
            "Bash(npm run format:check)",
            "Bash(npm run test:run)",
            "Bash(npm run test:run *)",
            "Bash(npm run test:coverage)",
            "Bash(npm run build)",
            "Bash(npm run e2e)",
            "Bash(npm run e2e *)",
            "Bash(npx vitest *)",
            "Bash(npx playwright test *)",
            "Bash(npx prettier *)",
            "Bash(npx eslint *)",
            "Bash(npx tsc *)",
            "Bash(node .claude/skills/fate-review/scripts/metrics.mjs *)",
            "Bash(git status)",
            "Bash(git status *)",
            "Bash(git diff)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git show *)",
            "Bash(uptime)"
        ],
        "ask": [
            "Bash(git push *)",
            "Bash(git reset --hard *)",
            "Bash(git clean *)",
            "Bash(git checkout -- *)",
            "Bash(npm install *)",
            "Bash(npm uninstall *)",
            "Edit(./.github/**)",
            "Edit(./.husky/**)",
            "Edit(./.claude/settings.json)",
            "Edit(./.claude/hooks/**)",
            "Edit(./scripts/guardrails/**)",
            "Edit(./package.json)",
            "Edit(./eslint.config.js)",
            "Edit(./vitest.config.ts)",
            "Edit(./playwright.config.ts)",
            "Edit(./tsconfig*.json)",
            "Edit(./e2e/tsconfig.json)",
            "Edit(./src/__tests__/guardrails.test.ts)",
            "Edit(./src/__tests__/storeApi.baseline.json)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./.env.*.local)",
            "Edit(./.env)",
            "Edit(./.env.local)",
            "Edit(./.env.*.local)",
            "Edit(./node_modules/**)",
            "Edit(./dist/**)",
            "Edit(./package-lock.json)",
            "Bash(git push --force *)",
            "Bash(git push -f *)",
            "Bash(npm publish *)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.mjs\"",
                        "timeout": 60,
                        "statusMessage": "Formatting and linting the edited file"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.mjs\"",
                        "timeout": 240,
                        "statusMessage": "Type-check and related tests"
                    }
                ]
            }
        ]
    }
}
