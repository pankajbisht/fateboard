# Patterns without a slash match at any depth (root, apps/web, apps/*, packages/*).
# Patterns with a slash are anchored, so they start with **/ to work inside apps/web too.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets / local config (only .env.example is committed)
.env
.env.*
!.env.example
*.local

# Dependencies and build output
node_modules
dist
dist-ssr
dist-e2e
*.tsbuildinfo

# Tests: Playwright (end-to-end) and coverage (npm run test:coverage)
test-results
playwright-report
blob-report
coverage

# Dead code kept locally for reference, never pushed (see README "Dead code")
deadcode/
.dead-code-backup-*.tar.gz

# Editor directories and files
**/.vscode/*
!**/.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code: personal files (the shared setup in .claude/ and CLAUDE.md is committed)
CLAUDE.local.md
**/.claude/settings.local.json
**/.claude/worktrees
